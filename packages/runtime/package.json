{
  "name": "@sw2d/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable SW2D runtime: scene lifecycle, semantic input, persistence, audio, accessibility, content, debug. Phaser-backed.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./composition": {
      "types": "./src/core/resolveInstallOrder.ts",
      "default": "./src/core/resolveInstallOrder.ts"
    },
    "./input-profiles": {
      "types": "./src/input/keyboardProfiles.ts",
      "default": "./src/input/keyboardProfiles.ts"
    }
  },
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "sideEffects": false,
  "dependencies": {
    "@sw2d/contracts": "0.1.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@sw2d/packs": "0.1.0",
    "@sw2d/schemas": "0.1.0"
  }
}

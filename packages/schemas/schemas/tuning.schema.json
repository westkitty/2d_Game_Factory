{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:content-tuning:v1",
  "title": "TuningDocument",
  "description": "The minimum content-document schema required to prove ContentBundle.data validates at the boundary. Values are positive magnitudes; sign/direction conventions (e.g. upward jump velocity) are a gameplay-layer concern, not this document's.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "player"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moveSpeed", "jumpVelocity", "gravity"],
      "properties": {
        "moveSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "jumpVelocity": { "type": "number", "exclusiveMinimum": 0 },
        "gravity": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}

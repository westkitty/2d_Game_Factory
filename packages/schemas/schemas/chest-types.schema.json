{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:content-chest-types:v1",
  "title": "ChestTypesDocument",
  "description": "Mirrors @sw2d/contracts ChestTypesDocument (chests.ts). Defines treasure chest types with discriminated locks and bounded traps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "chestTypes"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "chestTypes": {
      "type": "array",
      "items": { "$ref": "#/definitions/chestDefinition" }
    }
  },
  "definitions": {
    "chestDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tier", "lootTableId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "minLength": 1 },
        "lootTableId": { "type": "string", "minLength": 1 },
        "lock": { "$ref": "#/definitions/chestLockDefinition" },
        "trap": { "$ref": "#/definitions/chestTrapDefinition" }
      }
    },
    "chestLockDefinition": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["kind", "itemId"],
          "properties": {
            "kind": { "const": "key" },
            "itemId": { "type": "string", "minLength": 1 },
            "consumeKey": { "type": "boolean" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "difficulty"],
          "properties": {
            "kind": { "const": "pick" },
            "difficulty": {
              "type": "string",
              "enum": ["novice", "apprentice", "adept", "expert", "master"]
            }
          }
        }
      ]
    },
    "chestTrapDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectId"],
      "properties": {
        "effectId": { "type": "string", "minLength": 1 }
      }
    }
  }
}

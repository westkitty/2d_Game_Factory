{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:content-territory-catalog:v1",
  "title": "TerritoryCatalog",
  "description": "Mirrors @sw2d/contracts TerritoryCatalog (territory.ts). Validated as a ContentBundle.data document (document name 'territory'). Capture-zone occupancy - not box-select.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "zones"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "mode": { "type": "string", "enum": ["stand", "occupy"] },
    "factions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "victoryScore": { "type": "integer", "minimum": 1 },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "radius", "holdMs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "radius": { "type": "number", "exclusiveMinimum": 0 },
          "holdMs": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}

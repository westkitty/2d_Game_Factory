{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:content-race-catalog:v1",
  "title": "RaceCatalog",
  "description": "Mirrors @sw2d/contracts RaceCatalog (racing.ts). Content document name 'races'. Ordered checkpoints, laps and a countdown; race or time-trial mode.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "races"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "races": { "type": "array", "items": { "$ref": "#/definitions/race" } }
  },
  "definitions": {
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "mode", "startPositions", "countdownMs", "checkpoints", "laps"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["race", "time-trial"] },
        "countdownMs": { "type": "number", "minimum": 0 },
        "laps": { "type": "integer", "minimum": 1, "maximum": 99 },
        "startPositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "heading"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "heading": { "type": "number" } }
          }
        },
        "checkpoints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "x", "y", "radius"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "radius": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}

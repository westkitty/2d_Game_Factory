{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:content-codex-catalog:v1",
  "title": "CodexCatalog",
  "description": "Mirrors @sw2d/contracts CodexCatalog (codex.ts). Validated as a ContentBundle.data document (document name 'codex'). Exhibit / case entries - not portraits or parser IF.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "mode": { "type": "string", "enum": ["exhibit", "case"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "x": { "type": "number" }, "y": { "type": "number" },
          "image": { "type": "string", "minLength": 1 }, "portrait": { "type": "string", "minLength": 1 },
          "spotlightColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "deductions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "requireEntries", "links", "conclusion", "valid"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requireEntries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "links": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1 } } },
          "conclusion": { "type": "string", "minLength": 1 },
          "valid": { "type": "boolean" }
        }
      }
    }
  }
}

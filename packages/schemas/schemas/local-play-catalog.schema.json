{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:content-local-play-catalog:v1",
  "title": "LocalPlayCatalog",
  "description": "Mirrors @sw2d/contracts LocalPlayCatalog (localPlay.ts). Validated as a ContentBundle.data document (document name 'local-play'). Bounded local seats - no netcode, no gamepads, no split-screen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "players"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "mode": { "type": "string", "enum": ["hotseat", "versus"] },
    "players": {
      "type": "array",
      "items": { "$ref": "#/definitions/player" }
    },
    "hotseat": { "$ref": "#/definitions/hotseat" }
  },
  "definitions": {
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "negative": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "positive": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hotseat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "pointsCycle"],
      "properties": {
        "turns": { "type": "integer", "minimum": 1 },
        "pointsCycle": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}

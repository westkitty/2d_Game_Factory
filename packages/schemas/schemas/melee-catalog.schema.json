{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:content-melee-catalog:v1",
  "title": "MeleeCatalog",
  "description": "Mirrors @sw2d/contracts MeleeCatalog (melee.ts). Validated as a ContentBundle.data document (document name 'melee'). Close combat with combo chains, a facing arc, foe pursuit and hit-stun.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "player",
    "foes",
    "strike",
    "contact"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "skirmish",
        "arena"
      ]
    },
    "player": {
      "$ref": "#/definitions/fighter"
    },
    "foes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/fighter"
      }
    },
    "strike": {
      "$ref": "#/definitions/strike"
    },
    "contact": {
      "$ref": "#/definitions/contact"
    },
    "combo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "windowMs"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "damage",
              "knockback",
              "stunMs"
            ],
            "properties": {
              "damage": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "knockback": {
                "type": "number",
                "minimum": 0
              },
              "stunMs": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "windowMs": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "arcDeg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 360
    }
  },
  "definitions": {
    "fighter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "radius",
        "health"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "health": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "strike": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range",
        "damage",
        "cooldownMs",
        "knockback",
        "stunMs"
      ],
      "properties": {
        "range": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "damage": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cooldownMs": {
          "type": "number",
          "minimum": 0
        },
        "knockback": {
          "type": "number",
          "minimum": 0
        },
        "stunMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range",
        "damage",
        "cooldownMs"
      ],
      "properties": {
        "range": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "damage": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cooldownMs": {
          "type": "number",
          "minimum": 0
        },
        "stunMs": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}

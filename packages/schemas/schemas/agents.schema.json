{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:content-agents:v1",
  "title": "SimulationAgentsDocument",
  "description": "Mirrors @sw2d/contracts SimulationAgentsDocument (simulationAgents.ts). Content document name 'agents'. Need ids, behaviour ids and relationship metrics are all authored - the core assumes no vocabulary of its own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "needs", "behaviors", "agents"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "decisionIntervalMs": { "type": "number", "exclusiveMinimum": 0 },
    "minutesPerSecond": { "type": "number", "minimum": 0 },
    "needs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/need" } },
    "behaviors": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/behavior" } },
    "agents": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/agent" } },
    "workOrders": { "type": "array", "items": { "$ref": "#/definitions/workOrder" } }
  },
  "definitions": {
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimum", "maximum", "initial", "changePerSecond", "warningThreshold", "criticalThreshold"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "initial": { "type": "number" },
        "changePerSecond": { "type": "number" },
        "warningThreshold": { "type": "number" },
        "criticalThreshold": { "type": "number" }
      }
    },
    "condition": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["kind", "needId", "value"],
          "properties": {
            "kind": { "type": "string", "enum": ["need-below", "need-above"] },
            "needId": { "type": "string", "minLength": 1 },
            "value": { "type": "number" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "tag"],
          "properties": {
            "kind": { "type": "string", "enum": ["has-tag", "lacks-tag", "target-available"] },
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "activity"],
          "properties": {
            "kind": { "const": "schedule-activity" },
            "activity": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "effect": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["kind", "needId", "delta"],
          "properties": {
            "kind": { "const": "need-delta" },
            "needId": { "type": "string", "minLength": 1 },
            "delta": { "type": "number" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "needId", "value"],
          "properties": {
            "kind": { "const": "need-set" },
            "needId": { "type": "string", "minLength": 1 },
            "value": { "type": "number" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "tag"],
          "properties": {
            "kind": { "type": "string", "enum": ["add-tag", "remove-tag"] },
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "metricId", "delta"],
          "properties": {
            "kind": { "const": "relationship-delta" },
            "metricId": { "type": "string", "minLength": 1 },
            "delta": { "type": "number" }
          }
        }
      ]
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "baseUtility", "durationMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "baseUtility": { "type": "number" },
        "preconditions": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
        "needWeights": { "type": "object", "additionalProperties": { "type": "number" } },
        "targetTags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "durationMs": { "type": "number", "exclusiveMinimum": 0 },
        "cooldownMs": { "type": "number", "minimum": 0 },
        "effects": { "type": "array", "items": { "$ref": "#/definitions/effect" } },
        "interruptible": { "type": "boolean" }
      }
    },
    "scheduleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMinute", "endMinute", "activity"],
      "description": "Game-time minutes from midnight. A block whose start exceeds its end wraps past midnight.",
      "properties": {
        "startMinute": { "type": "integer", "minimum": 0, "maximum": 1439 },
        "endMinute": { "type": "integer", "minimum": 0, "maximum": 1439 },
        "activity": { "type": "string", "minLength": 1 },
        "locationTag": { "type": "string", "minLength": 1 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "needs", "behaviors"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "needs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "behaviors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "schedule": { "type": "array", "items": { "$ref": "#/definitions/scheduleBlock" } },
        "traits": { "type": "object", "additionalProperties": { "type": "number" } },
        "homeLocationTag": { "type": "string", "minLength": 1 }
      }
    },
    "workOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "priority", "durationMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "priority": { "type": "number" },
        "requiredAgentTags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "targetId": { "type": "string", "minLength": 1 },
        "locationTag": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}

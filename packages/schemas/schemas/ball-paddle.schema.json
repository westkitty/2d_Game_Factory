{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:content-ball-paddle:v1",
  "title": "BallPaddleDocument",
  "description": "Mirrors @sw2d/contracts BallPaddleDocument (ballPaddle.ts). Content document name 'ball-paddle'. One document drives both Breakout-style (bricks, loss edge) and Pong-style (goal edges, target score) games.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ball",
    "arena",
    "paddles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "ball": {
      "$ref": "#/definitions/ball"
    },
    "arena": {
      "$ref": "#/definitions/arena"
    },
    "paddles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/paddle"
      }
    },
    "bricks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/brick"
      }
    },
    "layout": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/placement"
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetScore": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lives": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "definitions": {
    "ball": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius",
        "initialSpeed",
        "minimumSpeed",
        "maximumSpeed",
        "speedIncreasePerHit",
        "maximumBounceAngleDegrees",
        "servePolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "initialSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimumSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximumSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speedIncreasePerHit": {
          "type": "number",
          "minimum": 0
        },
        "maximumBounceAngleDegrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 80
        },
        "servePolicy": {
          "$ref": "#/definitions/servePolicy"
        }
      }
    },
    "servePolicy": {
      "description": "A discriminated union, mirrored branch-for-branch from the contract's ServePolicy. Written as oneOf rather than if/then so Ajv strict mode can see every property each branch permits.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dx",
            "dy"
          ],
          "properties": {
            "kind": {
              "const": "fixed"
            },
            "dx": {
              "type": "number"
            },
            "dy": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dx",
            "dy"
          ],
          "properties": {
            "kind": {
              "const": "alternate"
            },
            "dx": {
              "type": "number"
            },
            "dy": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dx",
            "dy",
            "seed",
            "spreadDegrees"
          ],
          "properties": {
            "kind": {
              "const": "seeded-direction"
            },
            "dx": {
              "type": "number"
            },
            "dy": {
              "type": "number"
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "spreadDegrees": {
              "type": "number",
              "minimum": 0,
              "maximum": 80
            }
          }
        }
      ]
    },
    "arena": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom",
        "edges",
        "serveX",
        "serveY"
      ],
      "properties": {
        "left": {
          "type": "number"
        },
        "top": {
          "type": "number"
        },
        "right": {
          "type": "number"
        },
        "bottom": {
          "type": "number"
        },
        "serveX": {
          "type": "number"
        },
        "serveY": {
          "type": "number"
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "edge",
              "behavior"
            ],
            "properties": {
              "edge": {
                "type": "string",
                "enum": [
                  "left",
                  "right",
                  "top",
                  "bottom"
                ]
              },
              "behavior": {
                "type": "string",
                "enum": [
                  "bounce",
                  "goal",
                  "loss"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "scoresFor": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "paddle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "axis",
        "facing",
        "width",
        "height",
        "speed",
        "fixedX",
        "fixedY",
        "minTravel",
        "maxTravel",
        "bounceInfluence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "playerId": {
          "type": "string",
          "minLength": 1
        },
        "axis": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "facing": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "up",
            "down"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fixedX": {
          "type": "number"
        },
        "fixedY": {
          "type": "number"
        },
        "minTravel": {
          "type": "number"
        },
        "maxTravel": {
          "type": "number"
        },
        "bounceInfluence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "brick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hp",
        "score"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hp": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "itemDropId": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical sw2d.items item id (Phase 2). This system never invents its own items."
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "brickId",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "brickId": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}

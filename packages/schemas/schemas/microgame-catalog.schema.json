{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "urn:sw2d:schema:content-microgame-catalog:v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "order", "rounds"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "order": { "enum": ["fixed", "rotate"] },
    "rounds": { "type": "array", "items": { "$ref": "#/definitions/round" } }
  },
  "definitions": { "round": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "kind", "countdownMs", "durationMs", "target", "score"],
    "properties": {
      "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["react", "mash", "hold", "alternate"] },
      "countdownMs": { "type": "number", "minimum": 0 }, "durationMs": { "type": "number", "exclusiveMinimum": 0 },
      "target": { "type": "number", "exclusiveMinimum": 0 }, "score": { "type": "integer", "minimum": 0 }
    }
  } }
}

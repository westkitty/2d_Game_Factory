{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:content-camera-catalog:v1",
  "title": "CameraCatalog",
  "description": "Mirrors @sw2d/contracts CameraCatalog (camera.ts). Validated as a ContentBundle.data document (document name 'camera'). Rail-path camera and framing - not stage-scroll.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "points", "speed", "frame", "subjects", "shotsToWin"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "mode": { "type": "string", "enum": ["rail", "frame"] },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        }
      }
    },
    "speed": { "type": "number", "minimum": 0 },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "radius"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "radius": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "shotsToWin": { "type": "integer", "minimum": 0 }
  }
}

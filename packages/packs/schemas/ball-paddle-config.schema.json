{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:pack-ball-paddle-config:v1",
  "title": "BallPaddlePackConfig",
  "description": "Mirrors @sw2d/packs' BallPaddleConfig. All fields optional.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "autoServe": {
      "type": "boolean",
      "description": "Serve as soon as the pack installs. Defaults to false: the game decides when a round begins."
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sw2d:schema:pack-strategy-actions-config:v1",
  "title": "StrategyActionsPackConfig",
  "description": "Mirrors @sw2d/packs' StrategyActionsConfig. All fields optional.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "defaultQueueMode": {
      "type": "string",
      "enum": ["replace", "append", "front"],
      "description": "Queue policy applied when an issue request omits queueMode. Defaults to 'replace'."
    },
    "historyLimit": {
      "type": "integer",
      "minimum": 0,
      "description": "How many resolved orders history() retains. Defaults to 64."
    }
  }
}

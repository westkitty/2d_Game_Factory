/*
 * Local-only styling. System font stacks are used deliberately: a webfont
 * would mean a network request, and the offline guarantee is not negotiable.
 */
:root {
  --sw2d-bg: #0b0d13;
  --sw2d-panel: #1a1f2b;
  --sw2d-panel-active: #2b3446;
  --sw2d-text: #e8ecf4;
  --sw2d-text-muted: #8899aa;
  --sw2d-accent: #65d0a8;
  --sw2d-border: #384054;
  --sw2d-danger: #ff6b6b;
  --sw2d-warn: #ffd166;
  --sw2d-radius: 8px;
  --sw2d-shadow: 0 4px 16px rgb(0 0 0 / 40%);
  color-scheme: dark;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  height: 100%;
  background: var(--sw2d-bg);
  color: var(--sw2d-text);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  overscroll-behavior: none;
  -webkit-tap-highlight-color: transparent;
}

#app {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
}

#game-root {
  position: relative;
  flex: 1 1 auto;
  display: grid;
  place-items: center;
  min-height: 0;
}

#game-root canvas { display: block; max-width: 100%; max-height: 100%; object-fit: contain; }

/*
 * The visible Start control, centred over the canvas on the title screen.
 * Not gated on pointer: coarse - a desktop mouse user must see it too.
 * src/main.ts sets [hidden] once the run begins so it never covers gameplay.
 */
.start-overlay {
  position: absolute;
  left: 50%;
  bottom: 12%;
  transform: translateX(-50%);
  padding: 0.7rem 2rem;
  border: 1px solid var(--sw2d-accent);
  border-radius: 12px;
  background: var(--sw2d-panel);
  color: var(--sw2d-accent);
  font: inherit;
  font-size: 1.15rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  cursor: pointer;
  touch-action: manipulation;
  -webkit-user-select: none;
  user-select: none;
  transition: background 120ms, transform 120ms, box-shadow 120ms;
  box-shadow: var(--sw2d-shadow);
}

.start-overlay:hover { background: var(--sw2d-panel-active); box-shadow: 0 6px 24px rgb(0 0 0 / 50%); }
.start-overlay:active { transform: translateX(-50%) scale(0.97); }
.start-overlay:focus-visible { outline: 3px solid var(--sw2d-accent); outline-offset: 3px; }
.start-overlay[hidden] { display: none; }

.touch-controls {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.75rem 1rem 1.25rem;
  touch-action: none;
}

.touch-controls[hidden] { display: none; }

.touch-cluster { display: flex; gap: 0.75rem; }

.touch-button {
  min-width: 56px;
  min-height: 56px;
  border: 1px solid var(--sw2d-border);
  border-radius: 14px;
  background: var(--sw2d-panel);
  color: var(--sw2d-text);
  font: inherit;
  font-size: 1.1rem;
  touch-action: none;
  -webkit-user-select: none;
  user-select: none;
  transition: background 80ms, transform 80ms;
}

.touch-button:active { background: var(--sw2d-panel-active); transform: scale(0.95); }
.touch-button--primary { border-color: var(--sw2d-accent); color: var(--sw2d-accent); }
.touch-button:focus-visible { outline: 3px solid var(--sw2d-accent); outline-offset: 2px; }

/* ---------- In-game HUD overlay ---------- */

.game-hud {
  position: absolute;
  top: 8px;
  left: 8px;
  right: 8px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  pointer-events: none;
  z-index: 10;
  font-size: 0.8rem;
}

.hud-group { display: flex; gap: 8px; flex-wrap: wrap; }

.hud-item {
  background: rgb(26 31 43 / 80%);
  border: 1px solid var(--sw2d-border);
  border-radius: var(--sw2d-radius);
  padding: 4px 10px;
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  gap: 6px;
}

.hud-item__label { color: var(--sw2d-text-muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; }
.hud-item__value { color: var(--sw2d-accent); font-weight: 600; }
.hud-item--danger .hud-item__value { color: var(--sw2d-danger); }
.hud-item--warn .hud-item__value { color: var(--sw2d-warn); }

/* ---------- Keyboard hints overlay ---------- */

.keyboard-hints {
  position: absolute;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
  pointer-events: none;
  z-index: 10;
  opacity: 0.7;
  transition: opacity 200ms;
}

.keyboard-hints:hover { opacity: 1; }

.key-hint {
  background: rgb(26 31 43 / 70%);
  border: 1px solid var(--sw2d-border);
  border-radius: 4px;
  padding: 2px 8px;
  font-size: 0.7rem;
  color: var(--sw2d-text-muted);
  backdrop-filter: blur(4px);
}

.key-hint kbd {
  display: inline-block;
  background: var(--sw2d-panel-active);
  border: 1px solid var(--sw2d-border);
  border-radius: 3px;
  padding: 0 4px;
  font-size: 0.65rem;
  margin-right: 4px;
}

/* ---------- Screen transition flash ---------- */

.screen-flash {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 20;
  opacity: 0;
  transition: opacity 150ms;
}

.screen-flash--hit { background: rgb(255 107 107 / 30%); opacity: 1; animation: flash-out 300ms ease-out forwards; }
.screen-flash--pickup { background: rgb(101 208 168 / 20%); opacity: 1; animation: flash-out 200ms ease-out forwards; }

@keyframes flash-out { to { opacity: 0; } }

/* ---------- Pause overlay improvements ---------- */

.pause-indicator {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgb(26 31 43 / 90%);
  border: 1px solid var(--sw2d-border);
  border-radius: var(--sw2d-radius);
  padding: 16px 32px;
  font-size: 1.2rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  pointer-events: none;
  z-index: 15;
  backdrop-filter: blur(8px);
}

/* ---------- Improved noscript ---------- */

noscript {
  display: block;
  padding: 2rem;
  text-align: center;
  color: var(--sw2d-text-muted);
  font-size: 0.9rem;
}

{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "starter/src/**/*.ts",
    "starter/test/**/*.ts",
    "starter/vite.config.ts",
    "tools/**/*.ts",
    "demos/*/src/**/*.ts",
    "demos/*/tests/**/*.ts",
    "demos/*/vite.config.ts",
    "proofs/*/src/**/*.ts",
    "proofs/*/tests/**/*.ts",
    "proofs/*/vite.config.ts",
    "workbench/server/**/*.ts",
    "workbench/shared/**/*.ts",
    "workbench/src/**/*.ts",
    "workbench/test/**/*.ts",
    "workbench/vite.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "packages/cli/src/templates/**",
    "games/**"
  ]
}

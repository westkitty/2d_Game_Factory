{
  "name": "sw2d-game-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Stinky Weasel 2D Browser Game Factory - reusable, local-first, offline-capable 2D browser game production system.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "starter",
    "workbench",
    "games/*",
    "demos/*",
    "proofs/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run workbench:dev",
    "workbench:dev": "node --experimental-strip-types workbench/server/main.ts",
    "workbench:build": "vite build --config workbench/vite.config.ts",
    "workbench:start": "node --experimental-strip-types workbench/server/main.ts --production",
    "workbench:test": "vitest run workbench/test",
    "starter-kits:status": "node --experimental-strip-types tools/scripts/starter-kit-status.ts",
    "starter-kits:bootstrap": "node --experimental-strip-types tools/scripts/bootstrap-starter-kit.ts",
    "starter:dev": "npm run dev --workspace @sw2d/starter",
    "build": "npm run build --workspace @sw2d/starter",
    "preview": "npm run preview --workspace @sw2d/starter",
    "check:offline": "node tools/scripts/check-offline-build.mjs",
    "sw2d": "node --experimental-strip-types packages/cli/src/bin.ts",
    "qa:smoke": "node --experimental-strip-types packages/qa/src/runAll.ts",
    "qa:proof": "node --experimental-strip-types packages/qa/src/runProofs.ts",
    "qa:responsive": "node --experimental-strip-types tools/scripts/qa-responsive.ts",
    "release:verify": "node --experimental-strip-types tools/scripts/release-verify.ts",
    "qa:matrix": "node --experimental-strip-types tools/scripts/generated-runtime-matrix.ts",
    "qa:workbench": "node --experimental-strip-types workbench/qa/prepareBatchFixture.ts && npm run workbench:build && node --experimental-strip-types workbench/qa/runWorkbenchQa.ts",
    "qa:starter-kits:core": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits.ts",
    "qa:starter-kits:p2b": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p2b.ts",
    "qa:starter-kits:p2c": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p2c.ts",
    "qa:starter-kits:p3a": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3a.ts",
    "qa:starter-kits:p3b": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3b.ts",
    "qa:starter-kits:p3c": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3c.ts",
    "qa:starter-kits:p3d": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3d.ts",
    "qa:starter-kits:p3e": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3e.ts",
    "qa:starter-kits:p3f": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3f.ts",
    "qa:starter-kits:p3g": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3g.ts",
    "qa:starter-kits:p3h": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3h.ts",
    "qa:starter-kits:p3i": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3i.ts",
    "qa:starter-kits:p3j": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3j.ts",
    "qa:starter-kits:p3k": "node --experimental-strip-types tools/scripts/qa-expanded-starter-kits-p3k.ts",
    "qa:starter-kits": "npm run qa:starter-kits:core && npm run qa:starter-kits:p2b && npm run qa:starter-kits:p2c && npm run qa:starter-kits:p3a && npm run qa:starter-kits:p3b && npm run qa:starter-kits:p3c && npm run qa:starter-kits:p3d && npm run qa:starter-kits:p3e && npm run qa:starter-kits:p3f && npm run qa:starter-kits:p3g && npm run qa:starter-kits:p3h && npm run qa:starter-kits:p3i && npm run qa:starter-kits:p3j && npm run qa:starter-kits:p3k",
    "validate": "npm run typecheck && npm run test && npm run workbench:build && npm run build && npm run check:offline"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
